{
    "name": "tyhpdef/guzzlehttp-psr7-impl",
    "description": "Implementation package for tyhpdef/guzzlehttp-psr7. Require tyhpdef/guzzlehttp-psr7, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.1.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/psr-http-factory": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/guzzlehttp-psr7"
        }
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/psr7": "3.1.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-http-factory": "@dev"
    }
}
